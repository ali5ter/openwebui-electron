# Environment file for OpenWebUI Electron app
#
# Copy to ~/.config/openwebui-electron/env and set the values you need.
#
# OPENWEBUI_URL - URL where OpenWebUI is running
#   Default: http://localhost:8080
#   If OpenWebUI is on a different machine, use its LAN IP:
#     http://192.168.1.63:8080
OPENWEBUI_URL=http://localhost:8080
