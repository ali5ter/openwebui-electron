# Environment file for OpenWebUI Electron app
#
# Copy to ~/.config/openwebui-electron/env and set the values you need.
#
# OPENWEBUI_URL - URL where OpenWebUI is running
#   Default: http://localhost:8080
#   If OpenWebUI is on a different machine, use its LAN IP:
#     http://192.168.1.63:8080
OPENWEBUI_URL=http://localhost:8080

# OPENWEBUI_TIMEOUT_MS - how long to wait for the server before showing the
#   offline page, in milliseconds
#   Default: 15000
#   Raise this if you reach OpenWebUI over a VPN that is slow to bring the
#   tunnel up; the connection is accepted immediately but carries no data
#   until the route is established.
#OPENWEBUI_TIMEOUT_MS=15000
